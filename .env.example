# Firebase Production Config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# AI LLM CONFIGURATION (Real AI Chat & Resume Generator)
# Get a 100% Free Gemini API key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Optional: OpenAI API Key (if using OpenAI GPT-4o)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# PAYONEER CHECKOUT PAYMENT GATEWAY CONFIG
VITE_PAYONEER_MERCHANT_CODE=your_payoneer_merchant_code_here
VITE_PAYONEER_API_USERNAME=your_payoneer_api_username_here
PAYONEER_API_PASSWORD=your_payoneer_api_password_here
VITE_PAYONEER_PAYMENT_LINK=https://payoneer.me/your_account_link
PAYONEER_ENV=sandbox
# PAYHERE LK LIVE PAYMENT GATEWAY CONFIG (Sri Lanka & International)
VITE_PAYHERE_ENV=live
VITE_PAYHERE_MERCHANT_ID=your_payhere_merchant_id_here
VITE_PAYHERE_APP_ID=your_payhere_app_id_here
VITE_PAYHERE_APP_SECRET=your_payhere_app_secret_here
VITE_PAYHERE_SECRET=your_payhere_merchant_secret_here
